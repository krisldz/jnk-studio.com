# Skopiuj do .env i uzupełnij. Plik .env NIGDY nie trafia do repo.

# --- Współdzielony sekret: SvelteKit ↔ Rails API ---
# Token serwisowy, którym SvelteKit (server-side) autoryzuje się w Rails API.
# Wygeneruj np.: openssl rand -hex 32
API_TOKEN=

# --- Frontend (SvelteKit / apps/web) ---
# Adres API Rails w wewnętrznej sieci Dockera (tylko server-side).
API_INTERNAL_URL=http://backend:3000/api/v1
# Origin wystawiany przez reverse proxy (adapter-node, ochrona CSRF form actions).
ORIGIN=http://localhost:8080

# --- Baza danych (Postgres) ---
POSTGRES_USER=jnk
POSTGRES_PASSWORD=jnk
POSTGRES_DB=jnk_development

# --- Backend (Rails / apps/cms) ---
# W dev składane z powyższych; w prod ustaw pełny URL do zarządzanej bazy.
DATABASE_URL=postgres://jnk:jnk@db:5432/jnk_development
RAILS_ENV=development

# Konto administratora panelu /admin (tworzone przez db:seed). W prod ustaw własne.
ADMIN_EMAIL=admin@jnk-studio.com
ADMIN_PASSWORD=jnkstudio123
# Podgląd maili w dev (Mailpit); w prod realny SMTP.
SMTP_ADDRESS=mail
SMTP_PORT=1025

# --- Produkcja (compose.prod.yaml) ---
# Klucz do config/credentials (NIE commitować).
RAILS_MASTER_KEY=
# Domena obsługiwana przez Caddy (TLS Let's Encrypt).
APP_HOST=jnk-studio.com
# S3-kompatybilny storage mediów (Active Storage w prod).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
