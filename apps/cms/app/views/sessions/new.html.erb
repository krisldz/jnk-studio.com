<% content_for :title, "Logowanie — JNK Studio" %>

<div class="kicker mono">Panel CMS</div>
<h1>Zaloguj się</h1>

<%= form_with url: session_url, class: "form", style: "margin-top:28px" do |form| %>
  <div class="field">
    <%= form.label :email_address, "E-mail" %>
    <%= form.email_field :email_address, required: true, autofocus: true,
          autocomplete: "username", value: params[:email_address] %>
  </div>

  <div class="field">
    <%= form.label :password, "Hasło" %>
    <%= form.password_field :password, required: true,
          autocomplete: "current-password", maxlength: 72 %>
  </div>

  <div class="form-actions">
    <%= form.submit "Wejdź do panelu", class: "btn btn-accent" %>
    <%= link_to "Nie pamiętam hasła", new_password_path, class: "mono muted", style: "font-size:12px" %>
  </div>
<% end %>
