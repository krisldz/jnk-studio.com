<% content_for :title, "Blog — JNK Studio CMS" %>

<div class="page-head">
  <div>
    <div class="kicker mono">Blog</div>
    <h1>Wpisy</h1>
  </div>
  <%= link_to "Nowy wpis", new_admin_post_path, class: "btn btn-accent" %>
</div>

<% if @posts.any? %>
  <table class="table">
    <thead>
      <tr>
        <th></th>
        <th>Tytuł</th>
        <th>Kategoria</th>
        <th>Status</th>
        <th>Publikacja</th>
        <th style="text-align:right">Akcje</th>
      </tr>
    </thead>
    <tbody>
      <% @posts.each do |post| %>
        <tr>
          <td>
            <% if post.cover.attached? %>
              <%= image_tag post.cover.variant(resize_to_fill: [128, 88]), class: "thumb" %>
            <% else %>
              <span class="thumb ph"></span>
            <% end %>
          </td>
          <td>
            <%= link_to post.title(:pl) || "(bez tytułu)", edit_admin_post_path(post),
                  style: "text-decoration:none;font-weight:700" %>
            <% if post.featured? %><span class="mono muted" style="font-size:10px"> ★ wyróżniony</span><% end %>
          </td>
          <td class="muted"><%= post.post_category&.name(:pl) || "—" %></td>
          <td><span class="badge <%= post.status %>"><%= post.status %></span></td>
          <td class="mono muted"><%= post.published_at&.strftime("%Y-%m-%d") || "—" %></td>
          <td>
            <div class="actions" style="justify-content:flex-end">
              <%= button_to (post.published? ? "Ukryj" : "Publikuj"), publish_admin_post_path(post),
                    method: :patch, class: "btn btn-sm" %>
              <%= link_to "Edytuj", edit_admin_post_path(post), class: "btn btn-sm" %>
              <%= button_to "Usuń", admin_post_path(post), method: :delete, class: "btn btn-sm btn-danger",
                    form: { data: { turbo_confirm: "Usunąć ten wpis?" } } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty">Brak wpisów. <%= link_to "Dodaj pierwszy", new_admin_post_path %>.</div>
<% end %>
