<% content_for :title, "Kategorie bloga — JNK Studio CMS" %>

<div class="page-head">
  <div>
    <div class="kicker mono">Blog</div>
    <h1>Kategorie bloga</h1>
  </div>
  <%= link_to "Nowa kategoria", new_admin_post_category_path, class: "btn btn-accent" %>
</div>

<% if @post_categories.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Nazwa (PL)</th>
        <th>Nazwa (EN)</th>
        <th>Slug</th>
        <th>Wpisów</th>
        <th style="text-align:right">Akcje</th>
      </tr>
    </thead>
    <tbody>
      <% @post_categories.each do |category| %>
        <tr>
          <td style="font-weight:700"><%= category.name(:pl) || "—" %></td>
          <td class="muted"><%= category.name_en || "—" %></td>
          <td class="mono muted"><%= category.slug_pl || "—" %></td>
          <td class="mono"><%= category.posts.count %></td>
          <td>
            <div class="actions" style="justify-content:flex-end">
              <%= link_to "Edytuj", edit_admin_post_category_path(category), class: "btn btn-sm" %>
              <%= button_to "Usuń", admin_post_category_path(category), method: :delete, class: "btn btn-sm btn-danger",
                    form: { data: { turbo_confirm: "Usunąć tę kategorię?" } } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty">Brak kategorii bloga. <%= link_to "Dodaj pierwszą", new_admin_post_category_path %>.</div>
<% end %>
