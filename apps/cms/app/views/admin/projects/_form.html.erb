<%= form_with model: [:admin, project], class: "form" do |f| %>
  <% if project.errors.any? %>
    <div class="errors">
      <strong><%= pluralize(project.errors.count, "błąd", plural: "błędów") %> uniemożliwiły zapis:</strong>
      <ul>
        <% project.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <label>Tytuł</label>
    <div class="lang-pair">
      <div class="field">
        <span class="lang-tag">PL · wymagane</span>
        <%= f.text_field :title_pl, value: project.title_pl %>
      </div>
      <div class="field">
        <span class="lang-tag">EN</span>
        <%= f.text_field :title_en, value: project.title_en %>
      </div>
    </div>
  </div>

  <div class="field">
    <label>Slug (adres URL)</label>
    <div class="lang-pair">
      <div class="field">
        <span class="lang-tag">PL · wymagane · np. apartament-mokotow</span>
        <%= f.text_field :slug_pl, value: project.slug_pl %>
      </div>
      <div class="field">
        <span class="lang-tag">EN · np. mokotow-apartment</span>
        <%= f.text_field :slug_en, value: project.slug_en %>
      </div>
    </div>
  </div>

  <div class="field">
    <label>Zajawka (lead)</label>
    <div class="lang-pair">
      <div class="field">
        <span class="lang-tag">PL · wymagane</span>
        <%= f.text_area :lead_pl, value: project.lead_pl, rows: 3 %>
      </div>
      <div class="field">
        <span class="lang-tag">EN</span>
        <%= f.text_area :lead_en, value: project.lead_en, rows: 3 %>
      </div>
    </div>
  </div>

  <div class="field">
    <label>Treść (HTML)</label>
    <div class="lang-pair">
      <div class="field">
        <span class="lang-tag">PL · wymagane</span>
        <%= f.text_area :body_pl, value: project.body_pl, rows: 8 %>
      </div>
      <div class="field">
        <span class="lang-tag">EN</span>
        <%= f.text_area :body_en, value: project.body_en, rows: 8 %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="field">
      <%= f.label :status, "Status" %>
      <%= f.select :status, Project.statuses.keys.map { |s| [s, s] }, {}, {} %>
    </div>
    <div class="field">
      <%= f.label :category_id, "Kategoria" %>
      <%= f.select :category_id,
            Category.ordered.map { |c| [c.name(:pl), c.id] },
            { include_blank: "— brak —" } %>
    </div>
  </div>

  <div class="row">
    <div class="field">
      <%= f.label :year, "Rok" %>
      <%= f.number_field :year, value: project.year %>
    </div>
    <div class="field">
      <%= f.label :area_m2, "Powierzchnia (m²)" %>
      <%= f.number_field :area_m2, value: project.area_m2 %>
    </div>
    <div class="field">
      <%= f.label :location, "Lokalizacja" %>
      <%= f.text_field :location, value: project.location %>
    </div>
  </div>

  <div class="row">
    <div class="field">
      <%= f.label :position, "Kolejność" %>
      <%= f.number_field :position, value: project.position %>
    </div>
    <div class="field" style="display:flex;flex-direction:column;justify-content:flex-end">
      <label class="mono" style="display:flex;gap:10px;align-items:center;text-transform:none">
        <%= f.check_box :featured, style: "width:20px;height:20px;accent-color:#b2db18" %>
        Wyróżniona na stronie głównej
      </label>
    </div>
  </div>

  <div class="field">
    <%= f.label :cover, "Okładka" %>
    <% if project.cover.attached? %>
      <div style="margin-bottom:12px">
        <%= image_tag project.cover.variant(resize_to_limit: [320, 220]), style: "border:1px solid #231f20;display:block" %>
      </div>
    <% end %>
    <%= f.file_field :cover, accept: "image/*" %>
  </div>

  <div class="form-actions">
    <%= f.submit submit_label, class: "btn btn-accent" %>
    <%= link_to "Anuluj", admin_projects_path, class: "btn" %>
  </div>
<% end %>
