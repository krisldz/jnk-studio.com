#!/bin/bash -e

# Entrypoint dev: samonaprawialny start przy zamontowanych źródłach i wolumenie gemów.

# 1) Zainstaluj gemy, jeśli wolumen bundle jest pusty lub Gemfile się zmienił.
if ! bundle check > /dev/null 2>&1; then
  echo "[entrypoint-dev] Instaluję gemy (bundle install)..."
  bundle install
fi

# 2) Przy starcie serwera przygotuj bazę (create + migrate + seed jeśli trzeba).
if [ "${1}" = "bin/rails" ] && [ "${2}" = "server" ]; then
  echo "[entrypoint-dev] Przygotowuję bazę (db:prepare)..."
  bundle exec rails db:prepare
  rm -f tmp/pids/server.pid
fi

exec "${@}"
